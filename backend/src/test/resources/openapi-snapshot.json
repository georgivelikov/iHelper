{
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "description" : "Access token lifetime in seconds",
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "description" : "Only present when the request sent X-Token-Transport: body (mobile). The web app gets it as an HttpOnly cookie instead.",
            "type" : [ "string", "null" ]
          },
          "tokenType" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserDto"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType", "user" ],
        "type" : "object"
      },
      "BinEmptied" : {
        "properties" : {
          "purged" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "purged" ],
        "type" : "object"
      },
      "CategoryCreateRequest" : {
        "properties" : {
          "color" : {
            "pattern" : "^#[0-9a-fA-F]{6}$",
            "type" : "string"
          },
          "id" : {
            "description" : "Client-generated UUID. Re-sending an existing id returns the existing category.",
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "CategoryDto" : {
        "properties" : {
          "color" : {
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deletedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "position" : {
            "description" : "Display order, 0 first. Change it with PUT /categories/order",
            "format" : "int32",
            "type" : "integer"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "createdAt", "id", "name", "position", "updatedAt", "version" ],
        "type" : "object"
      },
      "CategoryReorderRequest" : {
        "properties" : {
          "ids" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 500,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "ids" ],
        "type" : "object"
      },
      "CategoryUpdateRequest" : {
        "properties" : {
          "color" : {
            "pattern" : "^#[0-9a-fA-F]{6}$",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "version" : {
            "description" : "Version last seen by the client. May instead be sent as If-Match header.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "password" : {
            "maxLength" : 72,
            "minLength" : 0,
            "type" : "string"
          },
          "username" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      },
      "PageResponseTaskDto" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/TaskDto"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "items", "page", "size", "total" ],
        "type" : "object"
      },
      "RefreshRequest" : {
        "description" : "Mobile clients send the refresh token here; the web app relies on the HttpOnly cookie",
        "properties" : {
          "refreshToken" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "inviteCode" : {
            "description" : "Required when the server runs registration in invite mode",
            "type" : [ "string", "null" ]
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 10,
            "type" : "string"
          },
          "username" : {
            "maxLength" : 50,
            "minLength" : 3,
            "pattern" : "^[A-Za-z0-9_.-]+$",
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      },
      "SyncResponse" : {
        "properties" : {
          "categories" : {
            "items" : {
              "$ref" : "#/components/schemas/CategoryDto"
            },
            "type" : "array"
          },
          "serverTime" : {
            "format" : "date-time",
            "type" : "string"
          },
          "tasks" : {
            "items" : {
              "$ref" : "#/components/schemas/TaskDto"
            },
            "type" : "array"
          }
        },
        "required" : [ "categories", "serverTime", "tasks" ],
        "type" : "object"
      },
      "TaskCounts" : {
        "properties" : {
          "bin" : {
            "format" : "int64",
            "type" : "integer"
          },
          "byCategory" : {
            "additionalProperties" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "object"
          },
          "inbox" : {
            "format" : "int64",
            "type" : "integer"
          },
          "total" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "bin", "byCategory", "inbox", "total" ],
        "type" : "object"
      },
      "TaskCreateRequest" : {
        "properties" : {
          "categoryId" : {
            "description" : "Omit or null for Inbox",
            "format" : "uuid",
            "type" : "string"
          },
          "description" : {
            "maxLength" : 5000,
            "minLength" : 0,
            "type" : "string"
          },
          "dueDate" : {
            "format" : "date",
            "type" : "string"
          },
          "id" : {
            "description" : "Client-generated UUID. Re-sending an existing id returns the existing task.",
            "format" : "uuid",
            "type" : "string"
          },
          "priority" : {
            "description" : "Defaults to MEDIUM",
            "enum" : [ "LOW", "MEDIUM", "HIGH", "URGENT" ],
            "type" : "string"
          },
          "status" : {
            "description" : "Defaults to TODO",
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ],
            "type" : "string"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "title" ],
        "type" : "object"
      },
      "TaskDto" : {
        "properties" : {
          "categoryId" : {
            "description" : "Null means Inbox",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "completedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deletedAt" : {
            "description" : "Set when the task is in the bin (also reported by /sync)",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "dueDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "priority" : {
            "enum" : [ "LOW", "MEDIUM", "HIGH", "URGENT" ],
            "type" : "string"
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ],
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "createdAt", "id", "priority", "status", "title", "updatedAt", "version" ],
        "type" : "object"
      },
      "TaskPatchRequest" : {
        "description" : "Only the fields present are changed. null clears description, categoryId and dueDate.",
        "properties" : {
          "categoryId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "dueDate" : {
            "format" : "date",
            "type" : "string"
          },
          "priority" : {
            "enum" : [ "LOW", "MEDIUM", "HIGH", "URGENT" ],
            "type" : "string"
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ],
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "version" : {
            "description" : "Optional guard; may instead be sent as If-Match header",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "TaskPurgeRequest" : {
        "properties" : {
          "ids" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 500,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "ids" ],
        "type" : "object"
      },
      "TaskUpdateRequest" : {
        "properties" : {
          "categoryId" : {
            "description" : "Null moves the task to Inbox",
            "format" : "uuid",
            "type" : "string"
          },
          "description" : {
            "maxLength" : 5000,
            "minLength" : 0,
            "type" : "string"
          },
          "dueDate" : {
            "format" : "date",
            "type" : "string"
          },
          "priority" : {
            "enum" : [ "LOW", "MEDIUM", "HIGH", "URGENT" ],
            "type" : "string"
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ],
            "type" : "string"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "version" : {
            "description" : "Version last seen by the client. May instead be sent as If-Match header.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "priority", "status", "title" ],
        "type" : "object"
      },
      "UserDto" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "username" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "iHelper API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "401 on bad credentials, 429 after repeated failures.",
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Token-Transport",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Sign in with username and password",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "ihelper_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Revoke the refresh token and clear the cookie; idempotent",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "The token comes from the request body (mobile) or the HttpOnly cookie (web).",
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "ihelper_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Token-Transport",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Trade a refresh token for a new access token (the refresh token rotates)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "description" : "403 when registration is closed or the invite code is wrong, 409 when the username is taken.",
        "operationId" : "register",
        "parameters" : [ {
          "description" : "Send 'body' to receive the refresh token in the response body (mobile)",
          "in" : "header",
          "name" : "X-Token-Transport",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Create an account and sign in",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/categories" : {
      "get" : {
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CategoryDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List all live categories (a small bounded set, so not paginated)",
        "tags" : [ "Categories" ]
      },
      "post" : {
        "description" : "201 when created. If the client-supplied id already exists, 200 with the existing category.",
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CategoryCreateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoryDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Create a category",
        "tags" : [ "Categories" ]
      }
    },
    "/api/v1/categories/order" : {
      "put" : {
        "description" : "Listed categories come first in the given order; unlisted ones follow in their current order. Returns every live category in the new order.",
        "operationId" : "reorder",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CategoryReorderRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CategoryDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Set the display order of categories",
        "tags" : [ "Categories" ]
      }
    },
    "/api/v1/categories/{id}" : {
      "delete" : {
        "description" : "Idempotent: deleting an already deleted category returns 204. An optional If-Match version guards against stale deletes.",
        "operationId" : "delete_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "If-Match",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Soft-delete a category; its tasks move to Inbox",
        "tags" : [ "Categories" ]
      },
      "get" : {
        "operationId" : "get_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoryDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "Categories" ]
      },
      "put" : {
        "operationId" : "update_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "If-Match",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CategoryUpdateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoryDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace a category; 409 with the current copy if the version is stale",
        "tags" : [ "Categories" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The signed-in user",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/sync" : {
      "get" : {
        "operationId" : "sync",
        "parameters" : [ {
          "description" : "UTC ISO-8601 instant, normally the serverTime of the previous sync. Omit for a full first sync.",
          "in" : "query",
          "name" : "since",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SyncResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Categories and tasks changed after a point in time, including deletions",
        "tags" : [ "Sync" ]
      }
    },
    "/api/v1/tasks" : {
      "get" : {
        "operationId" : "list",
        "parameters" : [ {
          "in" : "query",
          "name" : "categoryId",
          "required" : false,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "true = only tasks without a category (Inbox); overrides categoryId",
          "in" : "query",
          "name" : "inbox",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        }, {
          "in" : "query",
          "name" : "priority",
          "required" : false,
          "schema" : {
            "enum" : [ "LOW", "MEDIUM", "HIGH", "URGENT" ],
            "type" : "string"
          }
        }, {
          "description" : "Repeatable: status=TODO&status=IN_PROGRESS",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "items" : {
              "enum" : [ "TODO", "IN_PROGRESS", "DONE" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        }, {
          "description" : "Case-insensitive search in title and description",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Comma separated fields, '-' prefix = descending, e.g. priority,-dueDate. Fields: priority, dueDate, createdAt, updatedAt, title, status. Default: -priority,dueDate,createdAt",
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
